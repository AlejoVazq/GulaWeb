# Dominio público (con DNS apuntando al VPS). En local: localhost
DOMINIO=gula.ejemplo.com
# Contraseñas: generar con `openssl rand -base64 32`
POSTGRES_PASSWORD=cambiar-postgres
GULA_APP_PASSWORD=cambiar-gula-app
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
# Backups
BACKUP_PASSPHRASE=cambiar-passphrase-backup
# Opcional: remoto de rclone para copia fuera del VPS (ej: b2:gula-backups)
BACKUP_RCLONE_REMOTE=
