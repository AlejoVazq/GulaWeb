{
  "name": "@gula/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migraciones','dist/db/migraciones',{recursive:true})\"",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "admin": "tsx src/admin/cli.ts",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx src/db/migrar-cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@gula/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "~0.44.7",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.17",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "sharp": "~0.34.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "~0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
